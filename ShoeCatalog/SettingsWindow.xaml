<Window x:Class="ShoeCatalog.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeCatalog"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Width="450" Height="400" FontFamily="Times New Roman" FontSize="14">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Выберите, какие столбцы отображать в списке товаров" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,10"
                   TextAlignment="Center"/>

        <!-- Список столбцов -->
        <Border Grid.Row="1" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ColumnsPanel" Margin="5">
                    <!-- CheckBox будут добавлены в коде -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Выбрать все" 
                    Click="SelectAll_Click"  Background="#00FA9A" Padding="10,5" HorizontalAlignment="Right" Height="30" Margin="0,0,10,0"/>
            <Button Content="По умолчанию" 
                    Click="Default_Click"  Background="#FFBFBFBF" Padding="10,5" HorizontalAlignment="Right" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button Content="ОК" 
                    Click="OK_Click"
                    IsDefault="True"  Background="#00FA9A" 
                    Padding="10,5" HorizontalAlignment="Left" Height="30"/>
            <Button Content="Отмена" 
                    Click="Cancel_Click"
                    IsCancel="True"  Background="#FFEC675A" Padding="10,5" HorizontalAlignment="Left" Height="30" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
