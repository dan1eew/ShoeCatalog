<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShoeCatalog.MainWindow"
        Title="Список товаров" Height="650" Width="1200" FontFamily="Times New Roman" Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <BulletDecorator Background="Transparent">
                            <ContentPresenter Margin="0,0,0,0" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </BulletDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border x:Name="TopPanel" Grid.Row="0" Padding="10" VerticalAlignment="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IconImage" Width="40" Height="40" Margin="0,0,10,0" Source="/Icon.jpg"/>
                    <TextBlock x:Name="TitleTextBlock" Text="Shoe Catalog" FontSize="22" FontWeight="Bold" VerticalAlignment="Top"/>
                </StackPanel>

                <Label x:Name="VerTextLabel" Content="ver. 01.10" Grid.Column="1" FontSize="9"/>

                <Border Grid.Column="2" 
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFEDEDED"
                        CornerRadius="10" Padding="8,4" BorderThickness="1" BorderBrush="#FFABABAB">
                    <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center">
                        <RadioButton Content="☀" Checked="ThemeRadioButton_Checked"
                                     FontSize="20" GroupName="Theme" 
                                     IsChecked="True"  BorderBrush="{x:Null}" Background="{x:Null}" Foreground="#FFEDBB08"/>

                        <RadioButton Content="🌙" Checked="ThemeRadioButton_Checked"
                                     FontSize="20"
                                     GroupName="Theme" Margin="0,-2,0,0" BorderBrush="{x:Null}" Foreground="#FF001A84"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="ListViewProducts" Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фото" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Background="White" Width="80" Height="60" CornerRadius="3">
                                        <Image Source="{Binding ProductImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Артикул" Width="90" DisplayMemberBinding="{Binding Article}"/>
                        <GridViewColumn Header="Наименование" Width="200" DisplayMemberBinding="{Binding NameProduct}"/>
                        <GridViewColumn Header="Категория" Width="130" DisplayMemberBinding="{Binding CategoryProduct}"/>
                        <GridViewColumn Header="Производитель" Width="130" DisplayMemberBinding="{Binding Producer}"/>

                        <GridViewColumn Header="Цена" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceDisplay}" FontWeight="SemiBold" Foreground="{Binding PriceColor}" TextDecorations="{Binding PriceDecoration}"/>
                                        <TextBlock Text="{Binding FinalPrice, StringFormat=\{0\}₽}" FontSize="11" Foreground="{Binding FinalPriceColor}" Visibility="{Binding DiscountVisibility}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Скидка" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="5,2" HorizontalAlignment="Center" Background="#2E8B57">
                                        <TextBlock Text="{Binding CurrentDiscount, StringFormat=\{0\}%}" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Кол-во" Width="80" DisplayMemberBinding="{Binding QuantityInStock}"/>
                        <GridViewColumn Header="Описание" Width="250" DisplayMemberBinding="{Binding DescriptionProduct}"/>
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="{Binding RowColor}"/>
                        <Setter Property="BorderBrush" Value="#EEEEEE"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="MinHeight" Value="70"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFD1EFFF"/>
                                <Setter Property="BorderBrush" Value="#FF0078D7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Нижняя панель -->
        <Border x:Name="BottomPanelText" Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10" HorizontalAlignment="Left">
                    <TextBlock x:Name="TimeTextBlock" Text="Ожидание обновления времени..." 
                               HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,2"/>
                    <TextBlock x:Name="IDTextBlock" Text="ID"
                               HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="RefreshButton" Content="Обновить список" Click="RefreshButton_Click" 
                            Background="#00FA9A" Padding="10,5" HorizontalAlignment="Right" Margin="0,5,0,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>