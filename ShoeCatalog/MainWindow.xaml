<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d" x:Class="ShoeCatalog.MainWindow" 
        Height="650" Width="1200"
        FontFamily="Times New Roman" Loaded="Window_Loaded">

    <!--Стиль для radio button-->
    <Window.Resources>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <BulletDecorator Background="Transparent">
                            <ContentPresenter Margin="0,0,0,0" RecognizesAccessKey="True"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </BulletDecorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель 0 строка-->
        <Border x:Name="TopPanel" Grid.Row="0" Padding="10" VerticalAlignment="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и заголовок 0 - 0-->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="IconImage" Width="40" Height="40" Margin="0,0,10,0" Source="/IconDark.JPG"/>
                    <TextBlock x:Name="TitleTextBlock" Text="Shoe Catalog" FontSize="20" 
                               FontWeight="Bold" VerticalAlignment="Top"/>
                </StackPanel>

                <!-- Version 0 - 1-->
                <Label x:Name = "VerTextLabel" Content="ver. 01.00" Grid.Column="1" FontSize="9"/>

                <!-- Переключатель темы 0 - 2-->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ThemeTextBlock" Text="Тема оформления:" 
                               Padding="0,5,0,0" Width="95"/>
                    <RadioButton x:Name="LightThemeRadio" 
                                 Content="☀" Foreground="#FFFFBB00" FontSize="20" Background="White"
                                 GroupName="Theme" IsChecked="True" Checked="ThemeRadioButton_Checked"/>

                    <RadioButton x:Name="DarkThemeRadio" 
                                 Content="🌙" Foreground="#FF0C3E90" FontSize="20" BorderBrush="White"
                                 GroupName="Theme" Checked="ThemeRadioButton_Checked" Margin="0,0,0,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область 1 строка -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Список товаров 1 - 0-->
            <ListView x:Name="ListViewProducts"
                      Grid.Row="0" Background="White"
                      BorderBrush="LightGray" BorderThickness="1"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <ListView.View>
                    <GridView>
                        <!-- Фото -->
                        <GridViewColumn Header="Фото" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" 
                                            Background="White" 
                                            Width="80" Height="60" CornerRadius="3">
                                        <Image Source="{Binding ProductImage}" 
                                               Stretch="Uniform" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Артикул -->
                        <GridViewColumn Header="Артикул" Width="90" DisplayMemberBinding="{Binding Article}"/>

                        <!-- Наименование -->
                        <GridViewColumn Header="Наименование" Width="200" DisplayMemberBinding="{Binding NameProduct}"/>

                        <!-- Категория -->
                        <GridViewColumn Header="Категория" Width="130" DisplayMemberBinding="{Binding CategoryProduct}"/>

                        <!-- Производитель -->
                        <GridViewColumn Header="Производитель" Width="130" DisplayMemberBinding="{Binding Producer}"/>

                        <!-- Цена -->
                        <GridViewColumn Header="Цена" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" 
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                                   FontWeight="SemiBold" Foreground="{Binding PriceColor}"
                                                   TextDecorations="{Binding PriceDecoration}"/>
                                        <TextBlock Text="{Binding FinalPrice, StringFormat=\{0\}₽}" 
                                                   FontSize="11" Foreground="{Binding FinalPriceColor}"
                                                   Visibility="{Binding DiscountVisibility}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Скидка -->
                        <GridViewColumn Header="Скидка" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            Padding="5,2"
                                            HorizontalAlignment="Center" Background="#2E8B57">
                                        <TextBlock Text="{Binding CurrentDiscount, StringFormat=\{0\}%}" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Количество -->
                        <GridViewColumn Header="Кол-во" Width="80" DisplayMemberBinding="{Binding QuantityInStock}"/>

                        <!-- Описание -->
                        <GridViewColumn Header="Описание" Width="250" DisplayMemberBinding="{Binding DescriptionProduct}"/>
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="Background" Value="{Binding RowColor}"/>
                        <Setter Property="BorderBrush" Value="#EEEEEE"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="MinHeight" Value="70"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFD1EFFF"/>
                                <Setter Property="BorderBrush" Value="#FF0078D7"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Нижняя панель 2 строка-->
        <Border x:Name="BottomPanelText" Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Казалось бы безполезная ху*ня 2 - 0-->
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10">
                    <TextBlock x:Name="TimeTextBlock" Text="Ожидание обновления времени..."
                                   HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,2"/>
                    <TextBlock x:Name="IDTextBlock"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Пустота 2 - 1-->
                
                <!-- Кнопка 2 - 2-->
                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="RefreshButton" Content="Обновить список" 
                                    Click="RefreshButton_Click" Background="#00FA9A"
                                    Padding="10,5" HorizontalAlignment="Right" Margin="0,5,0,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>